# =============================================================
# peka.next — Required Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.
# =============================================================

# ---------------------------------------------------------------
# Supabase (required)
# ---------------------------------------------------------------
# Public URL of your Supabase project (safe to expose in browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase anon key (public — only grants access within RLS policies)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Supabase service role key (server-side only — bypasses RLS, NEVER expose to browser)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ---------------------------------------------------------------
# MFA Backup Code Signing (required)
# ---------------------------------------------------------------
# Random 32+ character secret used to HMAC-sign the backup-code
# verification cookie. Must be distinct from SUPABASE_SERVICE_ROLE_KEY.
# Generate: openssl rand -base64 32
MFA_BACKUP_SECRET=replace-with-a-random-32-char-secret

# ---------------------------------------------------------------
# Application (optional)
# ---------------------------------------------------------------
# Override the public base URL (used for redirects / absolute URLs)
# Defaults to VERCEL_URL in Vercel deployments.
# NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
